<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="omr.uacm.sistemafitguide.PantallaCoachFormularioEjercicioController"
            style="-fx-background-color: #eef2f6; -fx-font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;"
            prefHeight="640.0" prefWidth="960.0">

    <!-- Top Header bar matching CoachPanel -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to bottom, #1a3c3c, #0f2a2a); -fx-background-radius: 0 0 20 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 12, 0, 0, 4);">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#Cancelar"
                        text="← Volver al Catálogo"
                        style="-fx-background-color: transparent; -fx-border-color: #4ecdc4; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #4ecdc4; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand;"/>

                <VBox spacing="2">
                    <Label fx:id="lblTituloPantalla" text="Formulario de Ejercicio"
                           style="-fx-text-fill: #ffffff; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblSubtituloPantalla" text="Configura las variables técnicas, repeticiones sugeridas y recursos multimedia"
                           style="-fx-text-fill: #a0c4c4; -fx-font-size: 12px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#GuardarEjercicio"
                        text="💾 Guardar Ejercicio"
                        style="-fx-background-color: #2a7a6a; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 22; -fx-cursor: hand; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.2),4,0,0,2);"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center Card -->
    <center>
        <VBox spacing="14" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="18" right="24" bottom="20" left="24"/>
            </padding>

            <VBox VBox.vgrow="ALWAYS" spacing="12" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);">
                <padding>
                    <Insets top="18" right="20" bottom="18" left="20"/>
                </padding>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                    <content>
                        <GridPane hgap="20.0" vgap="14.0" style="-fx-padding: 4 6 10 6;">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="130.0" prefWidth="150.0"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="220.0" prefWidth="260.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="130.0" prefWidth="150.0"/>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="220.0" prefWidth="260.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="36.0" prefHeight="38.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="36.0" prefHeight="38.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="36.0" prefHeight="38.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="36.0" prefHeight="38.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="36.0" prefHeight="38.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="85.0" prefHeight="95.0" vgrow="SOMETIMES"/>
                            </rowConstraints>
                            <children>
                                <!-- Row 0 -->
                                <Label text="Nombre del Ejercicio: *" style="-fx-text-fill: #1a2e2e; -fx-font-weight: bold; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="txtNombre" promptText="ej. Flexiones Diamante"
                                           style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10; -fx-padding: 7 12;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="Zona Muscular: *" style="-fx-text-fill: #1a2e2e; -fx-font-weight: bold; -fx-font-size: 13px;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                <ComboBox fx:id="cmbZonaCorporal" maxWidth="1.7976931348623157E308"
                                          style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10;" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                                <!-- Row 1 -->
                                <Label text="Nivel de Dificultad: *" style="-fx-text-fill: #1a2e2e; -fx-font-weight: bold; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <ComboBox fx:id="cmbNivel" maxWidth="1.7976931348623157E308"
                                          style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Tipo de Carga: *" style="-fx-text-fill: #1a2e2e; -fx-font-weight: bold; -fx-font-size: 13px;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                <ComboBox fx:id="cmbTipoPeso" maxWidth="1.7976931348623157E308"
                                          style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10;" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                                <!-- Row 2 -->
                                <Label text="Repeticiones Sugeridas:" style="-fx-text-fill: #1a2e2e; -fx-font-weight: bold; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <TextField fx:id="txtRepeticiones" promptText="ej. 12"
                                           style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10; -fx-padding: 7 12;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <Label text="Series Sugeridas:" style="-fx-text-fill: #1a2e2e; -fx-font-weight: bold; -fx-font-size: 13px;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                <TextField fx:id="txtSeries" promptText="ej. 3"
                                           style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10; -fx-padding: 7 12;" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                                <!-- Row 3 -->
                                <Label text="Descanso (segundos):" style="-fx-text-fill: #1a2e2e; -fx-font-weight: bold; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <TextField fx:id="txtDescanso" promptText="ej. 30"
                                           style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10; -fx-padding: 7 12;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                <Label text="Duración (segundos):" style="-fx-text-fill: #1a2e2e; -fx-font-weight: bold; -fx-font-size: 13px;" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                                <TextField fx:id="txtDuracion" promptText="ej. 30 (o 0 si es por reps)"
                                           style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10; -fx-padding: 7 12;" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                                <!-- Row 4 -->
                                <Label text="Ruta Imagen Previa:" style="-fx-text-fill: #1a2e2e; -fx-font-weight: bold; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <TextField fx:id="txtUrlImagen" promptText="ej. /omr/uacm/sistemafitguide/preview/..."
                                           style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10; -fx-padding: 7 12;" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                                <Label text="Ruta Video / GIF:" style="-fx-text-fill: #1a2e2e; -fx-font-weight: bold; -fx-font-size: 13px;" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                                <TextField fx:id="txtUrlVideo" promptText="ej. /omr/uacm/sistemafitguide/videos/..."
                                           style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10; -fx-padding: 7 12;" GridPane.columnIndex="3" GridPane.rowIndex="4"/>

                                <!-- Row 5: Descripción -->
                                <Label text="Descripción e Instrucciones:" style="-fx-text-fill: #1a2e2e; -fx-font-weight: bold; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                                <TextArea fx:id="txtDescripcion" promptText="Instrucciones posturales y ejecución técnica recomendada..."
                                          wrapText="true"
                                          style="-fx-background-color: #f4f8f8; -fx-border-color: #d8e4e4; -fx-border-radius: 10; -fx-background-radius: 10;"
                                          GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5"/>
                            </children>
                        </GridPane>
                    </content>
                </ScrollPane>

                <!-- Bottom Actions -->
                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <padding><Insets top="8" right="6" bottom="4" left="6"/></padding>
                    <Button mnemonicParsing="false" onAction="#Cancelar"
                            text="Cancelar"
                            style="-fx-background-color: #f0f4f4; -fx-text-fill: #5a6a6a; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;"/>
                    <Button mnemonicParsing="false" onAction="#GuardarEjercicio"
                            text="Guardar Cambios"
                            style="-fx-background-color: #2a7a6a; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 24; -fx-cursor: hand; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.18),4,0,0,2);"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>