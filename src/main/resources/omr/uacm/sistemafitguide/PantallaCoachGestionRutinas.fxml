<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="omr.uacm.sistemafitguide.PantallaCoachGestionRutinasController"
            style="-fx-background-color: #eef2f6; -fx-font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;"
            prefHeight="640.0" prefWidth="960.0">

    <!-- Top Header bar matching CoachPanel -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to bottom, #1a3c3c, #0f2a2a); -fx-background-radius: 0 0 20 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 12, 0, 0, 4);">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button mnemonicParsing="false" onAction="#RegresarMenu"
                        text="← Volver al Panel"
                        style="-fx-background-color: transparent; -fx-border-color: #4ecdc4; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #4ecdc4; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand;"/>

                <VBox spacing="2">
                    <Label text="Gestión de Rutinas y Atletas"
                           style="-fx-text-fill: #ffffff; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Supervisa los entrenamientos de los atletas y adapta su sobrecarga progresiva"
                           style="-fx-text-fill: #a0c4c4; -fx-font-size: 12px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnEditarProgresion" mnemonicParsing="false" onAction="#EditarRutinaProgresion"
                        text="⚙ Ajustar Progresión"
                        style="-fx-background-color: #2a7a6a; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.2),4,0,0,2);"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="14" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="16" right="24" bottom="20" left="24"/>
            </padding>

            <!-- Split horizontal -->
            <SplitPane dividerPositions="0.36" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: transparent; -fx-box-border: transparent; -fx-padding: 0;">
                <items>
                    <!-- Left Card: Users List -->
                    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);">
                        <padding>
                            <Insets top="14" right="14" bottom="14" left="14"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="👥 Atletas Registrados"
                                   style="-fx-text-fill: #1a2e2e; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>
                        <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: transparent; -fx-border-color: #e4eef0; -fx-border-radius: 10; -fx-background-radius: 10;">
                            <columns>
                                <TableColumn fx:id="colUsuarioId" prefWidth="40.0" text="ID"/>
                                <TableColumn fx:id="colUsuarioNombre" prefWidth="120.0" text="Nombre"/>
                                <TableColumn fx:id="colUsuarioPeso" prefWidth="55.0" text="Peso"/>
                                <TableColumn fx:id="colUsuarioAltura" prefWidth="55.0" text="Alt"/>
                                <TableColumn fx:id="colUsuarioGenero" prefWidth="55.0" text="Gen"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <!-- Right Card: User Routines & Details -->
                    <VBox spacing="12" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);">
                        <padding>
                            <Insets top="14" right="16" bottom="14" left="16"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT"
                              style="-fx-background-color: #f4f8f8; -fx-background-radius: 12; -fx-padding: 8 14;">
                            <Label fx:id="lblUsuarioSeleccionado" text="Selecciona un atleta de la lista para ver sus rutinas"
                                   style="-fx-text-fill: #1a2e2e; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </HBox>

                        <TableView fx:id="tablaRutinas" prefHeight="170.0" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: transparent; -fx-border-color: #e4eef0; -fx-border-radius: 10; -fx-background-radius: 10;">
                            <columns>
                                <TableColumn fx:id="colRutinaGrupo" prefWidth="90.0" text="Grupo"/>
                                <TableColumn fx:id="colRutinaNivel" prefWidth="90.0" text="Nivel"/>
                                <TableColumn fx:id="colRutinaTipo" prefWidth="100.0" text="Tipo Carga"/>
                                <TableColumn fx:id="colRutinaSeries" prefWidth="60.0" text="Series"/>
                                <TableColumn fx:id="colRutinaDescanso" prefWidth="80.0" text="Desc (s)"/>
                                <TableColumn fx:id="colRutinaPeso" prefWidth="80.0" text="Extra (kg)"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>

                        <!-- Routine Detail Heading -->
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="🎯 Detalle de Repeticiones por Ejercicio"
                                   style="-fx-text-fill: #1a2e2e; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </HBox>

                        <TableView fx:id="tablaDetalle" prefHeight="130.0"
                                   style="-fx-background-color: transparent; -fx-border-color: #e4eef0; -fx-border-radius: 10; -fx-background-radius: 10;">
                            <columns>
                                <TableColumn fx:id="colDetalleNombre" prefWidth="320.0" text="Ejercicio"/>
                                <TableColumn fx:id="colDetalleReps" prefWidth="140.0" text="Repeticiones Objetivo"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </items>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>

