<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="omr.uacm.sistemafitguide.PantallaCoachEditarRutinaController"
            style="-fx-background-color: #eef2f6; -fx-font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;"
            prefHeight="640.0" prefWidth="960.0">

    <!-- Top Header bar matching CoachPanel -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to bottom, #1a3c3c, #0f2a2a); -fx-background-radius: 0 0 20 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 12, 0, 0, 4);">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#Cancelar"
                        text="← Volver a Rutinas"
                        style="-fx-background-color: transparent; -fx-border-color: #4ecdc4; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #4ecdc4; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand;"/>

                <VBox spacing="2">
                    <Label fx:id="lblTituloPantalla" text="Ajuste de Sobrecarga Progresiva"
                           style="-fx-text-fill: #ffffff; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <HBox spacing="10">
                        <Label fx:id="lblInfoUsuario" text="Atleta: Usuario"
                               style="-fx-text-fill: #4ecdc4; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="·" style="-fx-text-fill: #a0c4c4;"/>
                        <Label fx:id="lblInfoRutina" text="Rutina: Grupo · Nivel · Tipo"
                               style="-fx-text-fill: #a0c4c4; -fx-font-size: 12px;"/>
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnGuardarProgresion" mnemonicParsing="false" onAction="#GuardarProgresion"
                        text="💾 Guardar Progresión"
                        style="-fx-background-color: #2a7a6a; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 22; -fx-cursor: hand; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.2),4,0,0,2);"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center Content: Two Cards -->
    <center>
        <VBox spacing="14" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="18" right="24" bottom="20" left="24"/>
            </padding>

            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <!-- Left Card: Global Progression Variables -->
                <VBox maxWidth="350.0" prefWidth="340.0" spacing="14.0"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2); -fx-padding: 18;">
                    <children>
                        <Label text="⚡ Variables de Sobrecarga"
                               style="-fx-text-fill: #1a2e2e; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label text="Ajusta el volumen, pausas e intensidad de la rutina asignada:"
                               style="-fx-text-fill: #6a7a7a; -fx-font-size: 12px;" wrapText="true"/>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Series (Vueltas al Circuito):"
                                       style="-fx-text-fill: #1a2e2e; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <Spinner fx:id="spSeries" editable="true" maxWidth="1.7976931348623157E308" prefHeight="36.0"
                                         style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10;"/>
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Descanso entre Ejercicios (segundos):"
                                       style="-fx-text-fill: #1a2e2e; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <Spinner fx:id="spDescanso" editable="true" maxWidth="1.7976931348623157E308" prefHeight="36.0"
                                         style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10;"/>
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Peso Extra a Cargar (kg):"
                                       style="-fx-text-fill: #1a2e2e; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtPesoExtra" prefHeight="36.0" promptText="ej. 5.0"
                                           style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10; -fx-padding: 6 12;"/>
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <!-- Tip card matching CoachPanel dark gradient card -->
                        <VBox spacing="6"
                              style="-fx-background-color: linear-gradient(to bottom right, #1a3c3c, #0d2828);
                                     -fx-background-radius: 12; -fx-padding: 12;">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="Consejo del Coach"
                                       style="-fx-text-fill: #4ecdc4; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            </HBox>
                            <Label text="Un incremento paulatino del 5 al 10% en repeticiones o peso cada dos semanas promueve adaptaciones óptimas evitando lesiones."
                                   style="-fx-text-fill: #e0f0f0; -fx-font-size: 11px; -fx-font-style: italic; -fx-line-spacing: 1.5;"
                                   wrapText="true"/>
                        </VBox>
                    </children>
                </VBox>

                <!-- Right Card: Repetitions Table -->
                <VBox spacing="10.0"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2); -fx-padding: 18;"
                      HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="🎯 Repeticiones Objetivo por Ejercicio"
                                       style="-fx-text-fill: #1a2e2e; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="(Haz doble clic en el número para editar)"
                                       style="-fx-text-fill: #7a8a8a; -fx-font-style: italic; -fx-font-size: 11px;"/>
                            </children>
                        </HBox>

                        <TableView fx:id="tablaEjerciciosReps" prefHeight="260.0" prefWidth="450.0"
                                   style="-fx-background-color: transparent; -fx-border-color: #e4eef0; -fx-border-radius: 10; -fx-background-radius: 10;"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNombreEjercicio" editable="false" prefWidth="280.0" text="Nombre del Ejercicio"/>
                                <TableColumn fx:id="colRepsObjetivo" prefWidth="140.0" style="-fx-alignment: CENTER;" text="Reps Objetivo (Doble Clic)"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>