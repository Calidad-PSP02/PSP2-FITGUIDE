<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="omr.uacm.sistemafitguide.PantallaCoachCatalogoEjerciciosController"
            style="-fx-background-color: #eef2f6; -fx-font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;"
            prefHeight="640.0" prefWidth="960.0">

    <!-- Top Header bar matching CoachPanel -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to bottom, #1a3c3c, #0f2a2a); -fx-background-radius: 0 0 20 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 12, 0, 0, 4);">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button mnemonicParsing="false" onAction="#RegresarMenu"
                        text="← Volver al Panel"
                        style="-fx-background-color: transparent; -fx-border-color: #4ecdc4; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #4ecdc4; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand;"/>

                <VBox spacing="2">
                    <Label text="Catálogo de Ejercicios"
                           style="-fx-text-fill: #ffffff; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Gestión, filtrado y edición del banco oficial de movimientos"
                           style="-fx-text-fill: #a0c4c4; -fx-font-size: 12px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button mnemonicParsing="false" onAction="#AgregarEjercicio"
                            text="+ Agregar Ejercicio"
                            style="-fx-background-color: #2a7a6a; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.2),4,0,0,2);"/>

                    <Button mnemonicParsing="false" onAction="#EditarEjercicio"
                            text="✎ Editar"
                            style="-fx-background-color: #3b7ea1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 16; -fx-cursor: hand;"/>

                    <Button mnemonicParsing="false" onAction="#EliminarEjercicio"
                            text="🗑 Eliminar"
                            style="-fx-background-color: #b54747; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 16; -fx-cursor: hand;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="14" style="-fx-background-color: transparent;">
            <padding>
                <Insets top="16" right="24" bottom="20" left="24"/>
            </padding>

            <!-- Filter Card -->
            <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);">
                <padding>
                    <Insets top="12" right="16" bottom="12" left="16"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🔍 Buscar:" style="-fx-text-fill: #1a2e2e; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtBusqueda" prefWidth="130.0" promptText="Nombre..."
                               style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10; -fx-padding: 6 10;"/>

                    <Label text="Zona:" style="-fx-text-fill: #1a2e2e; -fx-font-size: 12px; -fx-font-weight: bold;">
                        <HBox.margin><Insets left="4"/></HBox.margin>
                    </Label>
                    <ComboBox fx:id="cmbFiltroZona" prefWidth="105.0" style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10;"/>

                    <Label text="Máx Desc:" style="-fx-text-fill: #1a2e2e; -fx-font-size: 12px; -fx-font-weight: bold;">
                        <HBox.margin><Insets left="4"/></HBox.margin>
                    </Label>
                    <TextField fx:id="txtFiltroDescanso" prefWidth="60.0" promptText="ej. 30"
                               style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10; -fx-padding: 6 8;"/>

                    <Label text="Nivel:" style="-fx-text-fill: #1a2e2e; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cmbFiltroNivel" prefWidth="95.0" style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10;"/>

                    <Label text="Tipo:" style="-fx-text-fill: #1a2e2e; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cmbFiltroTipoPeso" prefWidth="105.0" style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10;"/>

                    <Label text="Ordenar por:" style="-fx-text-fill: #1a2e2e; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="cmbOrdenar" prefWidth="130.0" style="-fx-background-color: #f4f8f8; -fx-background-radius: 10; -fx-border-color: #d8e4e4; -fx-border-radius: 10;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="lblTotalRegistros" text="Total: 0 ejercicios"
                           style="-fx-background-color: #e0f7f5; -fx-text-fill: #0d8a7a; -fx-background-radius: 12; -fx-padding: 5 12; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- Table Card -->
            <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,2);">
                <padding>
                    <Insets top="12" right="14" bottom="12" left="14"/>
                </padding>
                <TableView fx:id="tablaEjercicios" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-border-color: #e4eef0; -fx-border-radius: 10; -fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="45.0" text="ID"/>
                        <TableColumn fx:id="colNombre" prefWidth="160.0" text="Nombre"/>
                        <TableColumn fx:id="colZona" prefWidth="90.0" text="Zona"/>
                        <TableColumn fx:id="colNivel" prefWidth="90.0" text="Nivel"/>
                        <TableColumn fx:id="colTipoPeso" prefWidth="95.0" text="Tipo Peso"/>
                        <TableColumn fx:id="colRepeticiones" prefWidth="60.0" text="Reps"/>
                        <TableColumn fx:id="colSeries" prefWidth="60.0" text="Series"/>
                        <TableColumn fx:id="colDescanso" prefWidth="75.0" text="Desc (s)"/>
                        <TableColumn fx:id="colDescripcion" prefWidth="240.0" text="Descripción e Instrucciones"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
 
